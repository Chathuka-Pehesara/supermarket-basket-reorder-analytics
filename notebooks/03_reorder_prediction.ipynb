   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SERIALIZING TRAINED MODEL ARTIFACTS FOR MEMBER 4\n",
      "✅ Saved: model_1_logistic_regression.joblib   (0.00 MB)\n",
      "✅ Saved: model_2_decision_tree.joblib         (0.16 MB)\n",
